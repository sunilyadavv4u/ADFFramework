	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "RSADFDev"
		},
		"LS_ADLSGen2_using_MI_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().serverfullpath}"
		},
		"LS_AccountKV_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://RSAKVDev.vault.azure.net/"
		},
		"LS_AzureSQL_Using_MI_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "@{linkedService().ServerName}"
		},
		"LS_AzureSQL_Using_MI_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().DatabaseName}"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
