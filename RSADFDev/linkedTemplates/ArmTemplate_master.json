{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "RSADFDev"
		},
		"LS_ADLSGen2_SPN_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().ServerName}"
		},
		"LS_ADLSGen2_SPN_properties_typeProperties_tenant": {
			"type": "string",
			"defaultValue": "@{linkedService().TenantId}"
		},
		"LS_ADLSGen2_SPN_properties_typeProperties_servicePrincipalId": {
			"type": "string",
			"defaultValue": "@{linkedService().ServicePrincipalID}"
		},
		"LS_ADLSGen2_Using_AK_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().AcountName}"
		},
		"LS_ADLSGen2_using_MI_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().serverfullpath}"
		},
		"LS_AccountKV_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://RSAKVDev.vault.azure.net/"
		},
		"LS_AzureSQLDatabase_Using_UIDPWD_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "@{linkedService().ServerName}"
		},
		"LS_AzureSQLDatabase_Using_UIDPWD_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().DatabaseName}"
		},
		"LS_AzureSQLDatabase_Using_UIDPWD_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "@{linkedService().username}"
		},
		"LS_AzureSQL_Using_MI_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "@{linkedService().ServerName}"
		},
		"LS_AzureSQL_Using_MI_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().DatabaseName}"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "RSADFDev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLSGen2_using_MI_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLSGen2_using_MI_properties_typeProperties_url')]"
					},
					"LS_AccountKV_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AccountKV_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureSQL_Using_MI_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_Using_MI_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_Using_MI_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_Using_MI_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "RSADFDev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLSGen2_SPN_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLSGen2_SPN_properties_typeProperties_url')]"
					},
					"LS_ADLSGen2_SPN_properties_typeProperties_tenant": {
						"value": "[parameters('LS_ADLSGen2_SPN_properties_typeProperties_tenant')]"
					},
					"LS_ADLSGen2_SPN_properties_typeProperties_servicePrincipalId": {
						"value": "[parameters('LS_ADLSGen2_SPN_properties_typeProperties_servicePrincipalId')]"
					},
					"LS_ADLSGen2_Using_AK_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLSGen2_Using_AK_properties_typeProperties_url')]"
					},
					"LS_AzureSQLDatabase_Using_UIDPWD_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQLDatabase_Using_UIDPWD_properties_typeProperties_server')]"
					},
					"LS_AzureSQLDatabase_Using_UIDPWD_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQLDatabase_Using_UIDPWD_properties_typeProperties_database')]"
					},
					"LS_AzureSQLDatabase_Using_UIDPWD_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQLDatabase_Using_UIDPWD_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'RSADFDev_ArmTemplate_0')]"
			]
		},
		{
			"name": "RSADFDev_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'RSADFDev_ArmTemplate_1')]"
			]
		}
	]
}